model User {
  id          String         @id @default(uuid())
  email       String         @unique
  password    String
  tokens      RefreshToken[]
  role        Role           @default(EMPLOYEE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  employee    Employee?
  attendances Attendance[]
}

enum Role {
  SITE_ADMIN
  EMPLOYEE
}
